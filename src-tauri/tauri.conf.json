{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prime Launcher",
  "version": "1.0.0",
  "identifier": "app.primelauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prime Launcher",
        "width": 1080,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "لانشر ماينكرافت عربي",
    "longDescription": "Prime Launcher: لانشر ماينكرافت عربي خفيف يدعم الدخول الأوفلاين، المودات، والسكنات.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
